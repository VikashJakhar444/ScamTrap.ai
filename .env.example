# --- ScamTrap AI configuration ---

# Google Gemini API key (format: AIza + 35 chars or AQ. + ...). Leave empty to use
# the system GEMINI_API_KEY environment variable or deterministic engine.
GEMINI_API_KEY=""

# Second Gemini key - separate free-tier quota bucket, used on 429 rotation.
GEMINI_API_KEY_2=""

# Public https base URL used to build canary / receipt links handed to scammers.
# Point this at your live Cloudflare tunnel, ngrok or other public endpoint.
PUBLIC_TUNNEL_URL=""

# API key protecting /api/* from non-loopback callers.
# Auto-generated and appended on first run if left empty.
SCAMTRAP_API_KEY=""

# Backend bind address/port. Default is loopback-only; set HOST=0.0.0.0 to
# expose the dashboard on your LAN.
HOST=127.0.0.1
PORT=8000

# Seconds to wait for a Gemini response before falling back.
GEMINI_TIMEOUT_S=20

# Seconds a turn may spend waiting for a rate-limited bucket (groq 429s reset in
# ~30s, pollinations in ~15s) instead of dropping to a canned pool line.
GEMINI_WAIT_S=35

# groq-first stickiness: hold a turn this long for the top-priority provider
# (groq) while it is rate-limited, instead of letting pollinations/gemini take
# the conversation - groq writes the most natural Hinglish.
PREFERRED_WAIT_S=12

# --- Model provider rotation (nothing is truly unlimited - this is the chain) ---
# Order matters: groq first (30 req/min + 1000 req/day, free key, no card),
# then pollinations (keyless floor - no daily cap, anonymous 1 req/15s),
# gemini LAST (your keys above, small daily caps - reserve for when the rest are cooling).
MODEL_PRIORITY=groq,pollinations,gemini
GROQ_API_KEY=""
GROQ_API_KEY_2=""
OPENROUTER_API_KEY=""

# --- Used by wa_bridge.js ---
BACKEND_BASE=http://localhost:8000
